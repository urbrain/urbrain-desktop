{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Urbrain",
  "version": "1.0.0",
  "identifier": "ai.urbrain.desktop",
  "build": {
    "beforeDevCommand": "cd ../urbrain-client && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../urbrain-client && npm run build",
    "frontendDist": "../../urbrain-client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Urbrain",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI Operations Platform",
    "longDescription": "Urbrain — Run autonomous AI agents, review approvals, and monitor your AI workforce from your desktop.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_OUTPUT_OF_tauri_signer_generate",
      "endpoints": [
        "https://updates.urbrain.ai/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["urbrain"]
      }
    },
    "autostart": {
      "args": false
    }
  }
}
